{
  "name": "instapower",
  "productName": "InstaPower",
  "version": "1.0.0",
  "description": "A fast, focused Instagram desktop experience for Windows, built with Electron.",
  "main": ".webpack/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "build:windows": "npx --yes electron-builder@26.15.3 --win nsis portable"
  },
  "keywords": [
    "instagram",
    "desktop",
    "electron",
    "windows",
    "social",
    "client"
